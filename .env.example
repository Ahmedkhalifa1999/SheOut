# Copy to .env for local development. Never commit .env.

# 1 enables debug pages, the insecure dev secret key fallback and local media serving.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames the site is served on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (scheme + host) allowed to POST forms, e.g. https://shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional overrides.
# DJANGO_SQLITE_PATH=/var/lib/sheout/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/sheout/media
# DJANGO_TIME_ZONE=Africa/Cairo
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
